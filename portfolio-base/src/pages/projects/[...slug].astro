---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryHead from '../../components/entry/EntryHead.astro';
import EntryPager from '../../components/entry/EntryPager.astro';
import ReadingLayout from '../../components/entry/ReadingLayout.astro';
import RelatedList from '../../components/entry/RelatedList.astro';
import Link from '../../components/Link.astro';
import VideoFacade from '../../components/VideoFacade.astro';
import { getProjects, projectCode, projectHref, type Project } from '../../lib/collections';
import { neighbours, readingMinutes, related } from '../../lib/entries';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project, projects } }));
}

interface Props {
  project: Project;
  projects: Project[];
}
const { project, projects } = Astro.props;
const { title, summary, year, arch, stack, video, playlist, videoLabel, repo, live } = project.data;
const { Content, headings } = await render(project);

const isSelf = (p: Project) => p.id === project.id;
const { prev, next } = neighbours(projects, isSelf);
const position = `${projectCode(project)} / ${String(projects.length).padStart(2, '0')}`;
const keys = (p: Project) => [...p.data.stack, p.data.arch];
const close = related(projects, isSelf, keys, 3);
const more = close.length > 0 ? close : projects.filter((p) => !isSelf(p)).slice(0, 3);
const hasMedia = Boolean(video || playlist);
---

<BaseLayout title={`${title} — Yahir Eduardo Bravo`} description={summary}>
  <main id="main" class="panel">
    <article>
      <EntryHead
        back={{ href: '/projects/', label: 'All projects' }}
        position={position}
        title={title}
        lead={summary}
        facts={[
          { term: 'Architecture', value: arch },
          { term: 'Year', value: String(year) },
          { term: 'Stack', value: stack },
          { term: 'Reading', value: `${readingMinutes(project.body ?? '')} min` },
        ]}
      />

      <section class:list={['feature', { 'no-media': !hasMedia }]} aria-label="Video and links">
        {hasMedia && <VideoFacade title={title} label={videoLabel} video={video} playlist={playlist} />}
        <aside class="feature-side">
          {
            hasMedia && (
              <p class="feature-note">
                {video
                  ? 'A recorded walkthrough of the design decisions. The player loads from YouTube only when you press play.'
                  : 'The design system is explained in a video series on YouTube.'}
              </p>
            )
          }
          {
            (repo || live) && (
              <ul class="feature-links" aria-label="Project links">
                {repo && (
                  <li>
                    <Link class="btn" href={repo}>
                      Repository
                    </Link>
                  </li>
                )}
                {live && (
                  <li>
                    <Link class="btn" href={live}>
                      Live site
                    </Link>
                  </li>
                )}
              </ul>
            )
          }
        </aside>
      </section>

      <ReadingLayout headings={headings}>
        <Content />
      </ReadingLayout>
    </article>

    <footer class="entry-foot">
      <EntryPager
        prev={prev && { href: projectHref(prev), title: prev.data.title }}
        next={next && { href: projectHref(next), title: next.data.title }}
        prevLabel="Previous project"
        nextLabel="Next project"
      />
      <RelatedList
        title={close.length > 0 ? 'Related work' : 'More work'}
        items={more.map((p) => ({
          href: projectHref(p),
          title: p.data.title,
          meta: `${projectCode(p)} · ${p.data.arch} · ${p.data.year}`,
        }))}
      />
    </footer>
  </main>
</BaseLayout>

<style>
  .feature {
    container: feature / inline-size;
    display: grid;
    gap: 20px;
    margin-bottom: clamp(48px, 6vw, 88px);
  }
  .feature.no-media {
    margin-top: -24px;
  }
  .feature-side {
    display: grid;
    gap: 20px;
    align-content: start;
  }
  .feature-note {
    max-width: 36ch;
    margin: 0;
    font-size: 14px;
    line-height: 1.65;
    color: var(--mute);
  }
  .feature-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 1000px) {
    .feature:not(.no-media) {
      grid-template-columns: minmax(0, 3fr) minmax(220px, 1fr);
      column-gap: clamp(32px, 4vw, 64px);
      align-items: end;
    }
    .feature:not(.no-media) .feature-side {
      padding-bottom: 34px;
    }
    .feature:not(.no-media) .feature-links {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  .entry-foot {
    margin-top: clamp(64px, 8vw, 112px);
  }
</style>
