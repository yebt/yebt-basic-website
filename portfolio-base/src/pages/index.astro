---
import Hero from '../components/Hero.astro';
import Actions from '../components/Actions.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Experience from '../components/Experience.astro';
import PlantBuild from '../components/PlantBuild.astro';
import { basics, currentRole, cv, cvPage, education, languages, skills } from '../data/cv';
import { practice, site } from '../data/site';
import { getNotes, getProjects, noteHref } from '../lib/collections';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = await getProjects();
const featured = (projects.some((p) => p.data.featured) ? projects.filter((p) => p.data.featured) : projects).slice(0, 3);
const notes = (await getNotes()).slice(0, 4);

/** Person structured data from the CV. */
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: basics.name,
  jobTitle: currentRole?.title,
  worksFor: currentRole && { '@type': 'Organization', name: currentRole.organization },
  url: basics.website,
  email: `mailto:${basics.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Tuluá', addressRegion: 'Valle del Cauca', addressCountry: 'CO' },
  alumniOf: education.map((item) => ({ '@type': 'CollegeOrUniversity', name: item.institution })),
  knowsLanguage: languages.map((language) => language.name),
  knowsAbout: skills.flatMap((group) => group.items),
  sameAs: [basics.linkedin, basics.github],
};
---

<BaseLayout home>
  <Hero />
  <main id="main">
    <section id="work" class="panel work" aria-labelledby="work-title">
      <SectionHeader id="work-title" title="Selected work" href="/projects/" linkLabel="ALL PROJECTS · FILTER BY STACK" />
      <div class="cards">
        {featured.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>

    <Experience />

    <section id="practice" class="panel" aria-labelledby="practice-title">
      <SectionHeader id="practice-title" title="Practice" />
      <dl class="spec-list">
        {
          practice.map((row) => (
            <div class="spec">
              <dt>{row.term}</dt>
              <dd>{row.text}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section id="garden" class="panel" aria-labelledby="garden-title">
      <SectionHeader id="garden-title" title="Garden" href="/garden/" linkLabel="ALL NOTES" />
      <ul class="notes slab">
        {
          notes.map((note) => (
            <li>
              <a href={noteHref(note)}>
                <span class="note-title">{note.data.title}</span>
                <span class="note-meta">
                  {note.data.stage.toUpperCase()} · {note.data.tags[0].toUpperCase()}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="contact" class="panel contact" aria-labelledby="contact-title">
      <div class="board" aria-hidden="true">
        <PlantBuild size={196} onView />
      </div>
      <h2 id="contact-title" class="contact-title">Let's talk architecture.</h2>
      <p class="contact-mail"><a href={site.email}>{site.emailLabel}</a></p>
      <Actions
        class="contact-actions"
        label="Contact"
        actions={[
          { label: 'Email me', href: site.email, variant: 'tube' },
          cv,
          { label: 'CV (web)', href: cvPage },
          { label: `GitHub ${site.githubLabel}`, href: site.github, rel: 'me' },
          { label: 'LinkedIn', href: site.linkedin, rel: 'me' },
        ]}
      />
    </section>
  </main>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(person)} />
</BaseLayout>

<style>
  main {
    display: flex;
    flex-direction: column;
    gap: var(--module-gap);
    padding-block: var(--module-gap);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .spec-list {
    margin: 0;
    max-width: 1040px;
  }
  .spec {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 8px 32px;
    padding: 22px 0;
    border-top: 1px solid var(--line);
  }
  .spec dt {
    font-family: var(--font-display);
    font-size: 15px;
    color: var(--mute);
  }
  .spec dd {
    margin: 0;
    font-size: 17px;
    line-height: 1.55;
    max-width: 62ch;
  }
  .notes {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .notes li + li {
    border-top: 1px solid var(--line);
  }
  .notes a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 16px;
    align-items: baseline;
    padding: 18px 22px;
  }
  .note-title {
    font-size: 16px;
  }
  .note-meta {
    font-size: 12px;
    color: var(--mute);
    white-space: nowrap;
  }
  .contact {
    padding-block: clamp(56px, 8vw, 112px);
  }
  /*
   * Drawing board: the plant mark drawn from its blueprint when the module
   * scrolls into view, framed by registration axes. Decorative, to the right.
   */
  .board {
    position: absolute;
    top: 50%;
    right: 8%;
    display: grid;
    place-items: center;
    width: min(26vw, 300px);
    aspect-ratio: 1;
    transform: translateY(-50%);
    pointer-events: none;
    border: 1px solid var(--line);
    background:
      linear-gradient(var(--line), var(--line)) 50% 0 / 1px 100% no-repeat,
      linear-gradient(var(--line), var(--line)) 0 50% / 100% 1px no-repeat,
      linear-gradient(color-mix(in srgb, var(--blueprint) 12%, transparent) 1px, transparent 1px) 0 0 / 20px 20px,
      linear-gradient(90deg, color-mix(in srgb, var(--blueprint) 12%, transparent) 1px, transparent 1px) 0 0 / 20px 20px;
  }
  .board :global(.build) {
    width: 66%;
    height: auto;
    color: var(--ink);
  }
  .contact-title,
  .contact-mail,
  .contact :global(.contact-actions) {
    position: relative;
  }
  .contact-title {
    max-width: 18ch;
    font-size: clamp(32px, 4.4vw, 56px);
    line-height: 1.1;
    letter-spacing: 0.03em;
  }
  .contact-mail {
    margin: 20px 0 0;
    font-size: 16px;
    color: var(--mute);
    overflow-wrap: anywhere;
  }
  .contact-mail a:hover {
    color: var(--ink);
  }
  .contact :global(.contact-actions) {
    max-width: 760px;
    margin-top: 48px;
  }

  @media (max-width: 900px) {
    .board {
      display: none;
    }
  }

  @media (max-width: 820px) {
    .cards {
      grid-template-columns: 1fr;
    }
    .spec {
      grid-template-columns: 1fr;
    }
    .notes a {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .note-meta {
      white-space: normal;
    }
  }
</style>
