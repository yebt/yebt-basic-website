---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getNotes, type Note } from '../../lib/collections';

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

interface Props {
  note: Note;
}
const { note } = Astro.props;
const { title, stage, tags, updated } = note.data;
const { Content } = await render(note);
const date = new Intl.DateTimeFormat('en', { year: 'numeric', month: 'short', day: '2-digit', timeZone: 'UTC' }).format(updated);
---

<BaseLayout title={`${title} — Garden`} description={`${stage} note: ${title}`}>
  <main id="main" class="panel">
    <article class="note">
      <a class="back" href="/garden/">
        <svg width="16" height="10" viewBox="0 0 16 10" aria-hidden="true"><path d="M16 5H2M6 1L2 5l4 4" fill="none" stroke="currentColor"></path></svg>
        ALL NOTES
      </a>
      <h1 class="title">{title}</h1>
      <dl class="facts">
        <div><dt>STAGE</dt><dd>{stage.toUpperCase()}</dd></div>
        <div><dt>TAGS</dt><dd>{tags.map((t) => t.toUpperCase()).join(' · ')}</dd></div>
        <div><dt>UPDATED</dt><dd><time datetime={updated.toISOString()}>{date.toUpperCase()}</time></dd></div>
      </dl>
      <div class="prose">
        <Content />
      </div>
    </article>
  </main>
</BaseLayout>

<style>
  .note {
    max-width: 820px;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-family: var(--font-display);
    color: var(--mute);
  }
  .title {
    margin: 24px 0 32px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(30px, 5vw, 56px);
    line-height: 1.1;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 40px;
    margin: 0 0 40px;
    padding: 14px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .facts dt {
    font-size: 12px;
    color: var(--mute);
  }
  .facts dd {
    margin: 6px 0 0;
    font-family: var(--font-display);
    font-size: 15px;
  }
</style>
