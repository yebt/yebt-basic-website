---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryHead from '../../components/entry/EntryHead.astro';
import EntryPager from '../../components/entry/EntryPager.astro';
import ReadingLayout from '../../components/entry/ReadingLayout.astro';
import RelatedList from '../../components/entry/RelatedList.astro';
import { getNotes, noteHref, type Note } from '../../lib/collections';
import { neighbours, readingMinutes, related } from '../../lib/entries';

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((note) => ({ params: { slug: note.id }, props: { note, notes } }));
}

interface Props {
  note: Note;
  notes: Note[];
}
const { note, notes } = Astro.props;
const { title, stage, tags, updated } = note.data;
const { Content, headings } = await render(note);
const format = new Intl.DateTimeFormat('en', { year: 'numeric', month: 'short', day: '2-digit', timeZone: 'UTC' });
const date = format.format(updated);

/** What each growth stage means, as in the garden index. */
const stageNote = {
  seedling: 'A seedling: a rough idea, still changing.',
  budding: 'Budding: taking shape, not settled yet.',
  evergreen: 'Evergreen: settled, revised as it grows.',
} as const;

const isSelf = (n: Note) => n.id === note.id;
// The list is newest first: the previous entry is newer, the next one older.
const { prev, next } = neighbours(notes, isSelf);
const close = related(notes, isSelf, (n) => n.data.tags, 3);
---

<BaseLayout title={`${title} — Garden`} description={`${stage} note: ${title}`}>
  <main id="main" class="panel">
    <article>
      <EntryHead
        compact
        back={{ href: '/garden/', label: 'Garden' }}
        position={`Note ${String(notes.findIndex(isSelf) + 1).padStart(2, '0')} / ${String(notes.length).padStart(2, '0')}`}
        title={title}
        lead={stageNote[stage]}
        facts={[
          { term: 'Stage', value: stage },
          { term: 'Tags', value: tags },
          { term: 'Updated', value: date },
          { term: 'Reading', value: `${readingMinutes(note.body ?? '')} min` },
        ]}
      >
        <time class="sr-only" datetime={updated.toISOString()}>Updated {date}</time>
      </EntryHead>

      <ReadingLayout headings={headings}>
        <Content />
      </ReadingLayout>
    </article>

    <footer class="entry-foot">
      <EntryPager
        prev={prev && { href: noteHref(prev), title: prev.data.title }}
        next={next && { href: noteHref(next), title: next.data.title }}
        prevLabel="Newer note"
        nextLabel="Older note"
      />
      <RelatedList
        title="Related notes"
        items={close.map((n) => ({
          href: noteHref(n),
          title: n.data.title,
          meta: `${n.data.stage} · ${format.format(n.data.updated)}`,
        }))}
      />
    </footer>
  </main>
</BaseLayout>

<style>
  .entry-foot {
    margin-top: clamp(64px, 8vw, 112px);
  }
</style>
