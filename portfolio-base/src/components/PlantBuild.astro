---
/**
 * Hero plant mark, drawn once on load the way it would be on a drawing board.
 * Blueprint: hairline construction lines in blueprint blue (centre axis,
 * ground and node datums, leaf envelopes, centre marks, dimension lines)
 * draw in with stroke-dashoffset. Build: the mark's strokes are drawn over
 * them, the construction fades away, the nodes are set and the safety-orange
 * ground line goes in last. ~2.2 s, runs once.
 * Reduced motion: the finished mark only, no construction lines.
 */
import { plant } from '../data/plant';

interface Props {
  size?: number;
  class?: string;
}

const { size = 56, class: className } = Astro.props;

/** Circle as a path, so pathLength-based drawing behaves like every other line. */
const ring = (cx: number, cy: number, r: number) => `M${cx - r} ${cy}a${r} ${r} 0 1 0 ${2 * r} 0a${r} ${r} 0 1 0 ${-2 * r} 0`;

/** Construction lines in drawing order. */
const blueprint = [
  'M16 -2.5V33', // centre axis
  'M1 29.5H31', // ground datum
  'M3 22.4H29', // lower node datum
  'M3 16.4H29', // upper node datum
  ring(9.6, 18.2, 6.6), // lower leaf envelope
  ring(22.2, 12.2, 6.6), // upper leaf envelope
  ring(16, 6, 4), // bud envelope
  'M14.4 22.4h3.2M16 20.8v3.2', // centre mark, lower node
  'M14.4 16.4h3.2M16 14.8v3.2', // centre mark, upper node
  'M33 2.4V29.5M31.8 2.4h2.4M31.8 29.5h2.4', // height dimension
  'M9 32.5H23M9 31.3v2.4M23 31.3v2.4', // ground width dimension
];

/** Mark strokes in drawing order (ground line is drawn separately, last). */
const strokes = [plant.stem, plant.leafLow, plant.veinLow, plant.leafHigh, plant.veinHigh, plant.bud];
---

<svg
  class:list={['build', className]}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  aria-hidden="true"
  style={`--u: ${(32 / size).toFixed(4)}`}
>
  <g class="bp">
    {blueprint.map((d, i) => <path d={d} pathLength="1" style={`--i: ${i}`} />)}
  </g>
  <g class="ink">
    {strokes.map((d, i) => <path d={d} pathLength="1" style={`--i: ${i}`} />)}
  </g>
  <path class="ground" d={plant.ground} pathLength="1" />
  <g class="nodes">
    {plant.nodes.map(([cx, cy], i) => <circle cx={cx} cy={cy} r="1.4" style={`--i: ${i}`} />)}
  </g>
</svg>

<style>
  .build {
    display: block;
    flex: none;
    overflow: visible;
    /* One device-independent hairline, in user units. */
    --hair: calc(1.4px * var(--u));
  }
  path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .bp path {
    stroke: var(--blueprint);
    stroke-width: calc(var(--hair) * 0.55);
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    opacity: 0;
    animation:
      draw 520ms cubic-bezier(0.22, 1, 0.36, 1) calc(120ms + var(--i) * 55ms) both,
      bp-fade 2200ms linear both;
  }
  .ink path {
    stroke: currentColor;
    stroke-width: var(--hair);
    stroke-dasharray: 1;
    animation: draw 620ms cubic-bezier(0.65, 0, 0.35, 1) calc(820ms + var(--i) * 90ms) both;
  }
  .ground {
    stroke: var(--cable);
    stroke-width: calc(var(--hair) * 1.3);
    stroke-dasharray: 1;
    animation: draw 380ms cubic-bezier(0.22, 1, 0.36, 1) 1820ms both;
  }
  .nodes circle {
    fill: var(--cable);
    transform-box: fill-box;
    transform-origin: center;
    animation: set 260ms cubic-bezier(0.22, 1, 0.36, 1) calc(1500ms + var(--i) * 120ms) both;
  }
  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  /* Construction lines appear as they draw, hold, then give way to the mark. */
  @keyframes bp-fade {
    0%,
    4% {
      opacity: 0;
    }
    5%,
    62% {
      opacity: 0.85;
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes set {
    from {
      transform: scale(0);
    }
    to {
      transform: scale(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bp {
      display: none;
    }
    .ink path,
    .ground,
    .nodes circle {
      animation: none;
    }
  }
</style>
