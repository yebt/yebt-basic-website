---
/** Concrete slab project card. Presentational: receives a project entry. */
import { projectCode, projectHref, type Project } from '../lib/collections';

interface Props {
  project: Project;
  headingLevel?: 'h2' | 'h3';
}
const { project, headingLevel = 'h3' } = Astro.props;
const { title, summary, year, arch, stack, videoLabel, cover } = project.data;
const Heading = headingLevel;
---

<article class="card slab" data-stack={stack.join('|')}>
  <div class="meta"><span>{projectCode(project)}</span><span>{arch}</span><span>{year}</span></div>
  <div class="cover">
    {cover ? <img src={cover} alt="" loading="lazy" /> : <span>[COVER]</span>}
    <span class="video">
      <svg width="10" height="12" viewBox="0 0 10 12" aria-hidden="true"><path d="M1 1l8 5-8 5z" fill="currentColor" /></svg>
      {videoLabel}
    </span>
  </div>
  <div>
    <Heading class="name"><a href={projectHref(project)}>{title}</a></Heading>
    <p class="summary">{summary}</p>
  </div>
  <ul class="stack" aria-label="Stack">
    {stack.map((item) => <li>{item}</li>)}
  </ul>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: 22px;
  }
  .card:hover,
  .card:focus-within {
    border-color: var(--ink);
  }
  .meta,
  .stack {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    font-size: 12px;
  }
  .meta {
    color: var(--mute);
  }
  .cover {
    position: relative;
    aspect-ratio: 16 / 10;
    border: 1px solid var(--line);
    background-image: radial-gradient(var(--dot) 1px, transparent 1.3px);
    background-size: 9px 9px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 12px;
    font-size: 12px;
    color: var(--mute);
    overflow: hidden;
  }
  .cover img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .video {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
  }
  .name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 24px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  /* Whole card is the link target; the anchor stays the only focusable element. */
  .name a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .name a:focus-visible {
    outline: none;
  }
  .card:has(.name a:focus-visible) {
    outline: 1px solid var(--ink);
    outline-offset: 4px;
  }
  .summary {
    margin: 10px 0 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--mute);
  }
  .stack {
    margin: auto 0 0;
    padding: 14px 0 0;
    list-style: none;
    border-top: 1px dashed var(--line-strong);
    flex-wrap: wrap;
  }
</style>
