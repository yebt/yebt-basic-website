---
/**
 * Lite YouTube facade: a still frame, a play control and the label. Nothing
 * from YouTube loads except the thumbnail until the visitor asks for the
 * video; the click swaps in the privacy-enhanced player with autoplay.
 * Hover or focus preconnects first, so the swap is quick.
 * Without JS the facade is a plain link to the video on YouTube.
 * Playlists (no thumbnail without the API) render as a link card.
 */
import { NEW_TAB_HINT } from '../lib/links';
import { youtubeEmbedUrl, youtubeThumbnail, youtubeVideoId, youtubeWatchUrl } from '../lib/youtube';

interface Props {
  title: string;
  /** Short label, e.g. "WALKTHROUGH 12:04". */
  label: string;
  video?: string;
  playlist?: string;
  class?: string;
}

const { title, label, video, playlist, class: className } = Astro.props;
const id = video ? youtubeVideoId(video) : undefined;
const embed = video ? youtubeEmbedUrl(video, { autoplay: true }) : undefined;
---

{
  id && embed ? (
    <figure class:list={['video', className]}>
      <div class="frame">
        <a
          class="facade"
          href={youtubeWatchUrl(id)}
          target="_blank"
          rel="noopener noreferrer"
          data-yt
          data-embed={embed}
          data-title={`${title}: ${label}`}
        >
          <picture>
            <source type="image/webp" srcset={youtubeThumbnail(id, 'webp')} />
            <img src={youtubeThumbnail(id)} alt="" width="480" height="360" loading="lazy" decoding="async" />
          </picture>
          <span class="play">
            <svg width="14" height="16" viewBox="0 0 14 16" aria-hidden="true">
              <path d="M1 1l12 7-12 7z" fill="currentColor" />
            </svg>
            <span>
              Play<span class="sr-only"> video: {title}</span>
            </span>
          </span>
          <span class="sr-only"> {NEW_TAB_HINT}</span>
        </a>
      </div>
      <figcaption>
        <span>{label}</span>
        <span class="where">YouTube · loads on play</span>
      </figcaption>
    </figure>
  ) : playlist ? (
    <figure class:list={['video', className]}>
      <a class="playlist" href={playlist} target="_blank" rel="noopener noreferrer">
        <span class="stack" aria-hidden="true">
          <span />
          <span />
          <span />
        </span>
        <span class="playlist-text">
          <span class="playlist-kicker">{label}</span>
          <span class="playlist-title">
            Open the playlist on YouTube
            <svg width="12" height="12" viewBox="0 0 10 10" aria-hidden="true">
              <path d="M2 8 8 2M3.5 2H8v4.5" fill="none" stroke="currentColor" stroke-width="1.2" />
            </svg>
          </span>
        </span>
        <span class="sr-only"> {NEW_TAB_HINT}</span>
      </a>
    </figure>
  ) : null
}

<style>
  .video {
    margin: 0;
  }
  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--line-strong);
    background: var(--slot, #0b0c0c);
    overflow: hidden;
  }
  .frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .facade {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: inherit;
    text-decoration: none;
  }
  /* The new-tab arrow belongs to text links, not to this surface. */
  .facade::after {
    display: none !important;
  }
  .facade picture,
  .facade img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .facade img {
    /* hqdefault is 4:3 with letterbox bars; cover crops them away in the 16:9 frame. */
    object-fit: cover;
    filter: grayscale(0.55) contrast(1.05) brightness(0.82);
    transition: filter 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .facade::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(to top, rgba(10, 11, 11, 0.55), transparent 45%),
      radial-gradient(circle, rgba(236, 236, 230, 0.12) 1px, transparent 1.4px) 0 0 / 6px 6px;
  }
  .play {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 52px;
    padding: 0 26px;
    background: var(--tube);
    color: var(--tube-ink);
    font-family: var(--font-display);
    font-size: 15px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.6),
      0 0 14px 1px var(--tube-glow),
      0 0 52px 10px var(--tube-haze);
    transition:
      box-shadow 240ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .facade:hover img,
  .facade:focus-visible img {
    filter: none;
  }
  .facade:hover .play,
  .facade:focus-visible .play {
    transform: scale(1.04);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.8),
      0 0 18px 3px var(--tube-glow),
      0 0 72px 16px var(--tube-haze);
  }
  .facade:focus-visible {
    outline: 1px solid var(--tube);
    outline-offset: -6px;
  }
  figcaption {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 0 0;
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--mute);
  }
  .where {
    text-transform: uppercase;
  }

  /* Playlist link card: three stacked frames and the label. */
  .playlist {
    display: flex;
    align-items: center;
    gap: 28px;
    padding: 28px;
    border: 1px solid var(--line-strong);
    background: var(--slab);
    text-decoration: none;
  }
  .playlist:hover {
    border-color: var(--ink);
  }
  .playlist::after {
    display: none !important;
  }
  .stack {
    position: relative;
    flex: none;
    width: 112px;
    height: 72px;
  }
  .stack span {
    position: absolute;
    width: 96px;
    height: 54px;
    border: 1px solid var(--line-strong);
    background: var(--acrylic);
  }
  .stack span:nth-child(1) {
    left: 16px;
    top: 0;
  }
  .stack span:nth-child(2) {
    left: 8px;
    top: 8px;
  }
  .stack span:nth-child(3) {
    left: 0;
    top: 16px;
    border-color: var(--ink);
  }
  .playlist-text {
    display: grid;
    gap: 6px;
  }
  .playlist-kicker {
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--mute);
  }
  .playlist-title {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-size: 20px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: reduce) {
    .facade img,
    .play {
      transition: none;
    }
  }
</style>

<script>
  const ORIGINS = ['https://www.youtube-nocookie.com', 'https://www.google.com'];
  let warmed = false;

  /** Opens connections to the player's origins once, on the first sign of intent. */
  const warm = () => {
    if (warmed) return;
    warmed = true;
    for (const href of ORIGINS) {
      const link = document.createElement('link');
      link.rel = 'preconnect';
      link.href = href;
      document.head.append(link);
    }
  };

  for (const facade of document.querySelectorAll<HTMLAnchorElement>('a[data-yt]')) {
    facade.addEventListener('pointerenter', warm, { once: true });
    facade.addEventListener('focus', warm, { once: true });
    facade.addEventListener('click', (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.button === 1) return;
      event.preventDefault();
      warm();
      const iframe = document.createElement('iframe');
      iframe.src = facade.dataset.embed ?? '';
      iframe.title = facade.dataset.title ?? 'YouTube video';
      iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      facade.replaceWith(iframe);
      iframe.focus();
    });
  }
</script>
