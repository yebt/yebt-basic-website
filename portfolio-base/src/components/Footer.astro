---
import { site } from '../data/site';
---

<footer class="footer">
  <span>{site.domain}</span>
  <span>BUILT WITH ASTRO · CONTENT IN MARKDOWN</span>
  <span>© {new Date().getFullYear()}</span>
</footer>

<style>
  .footer {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    padding: 20px var(--gutter) 40px;
    border-top: 1px solid var(--line);
    font-size: 12px;
    color: var(--mute);
  }
</style>
