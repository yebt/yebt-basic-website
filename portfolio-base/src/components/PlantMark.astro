---
/**
 * Brand mark: a sprout drawn like a technical diagram. A stem rises from a
 * ground line; each leaf joins the stem at a node, the way modules hang off
 * a system. `line` keeps a hairline stroke at any size (header, hero);
 * `solid` is the filled form used for small icons.
 */
interface Props {
  variant?: 'line' | 'solid';
  size?: number;
  /** Paints the two nodes in the safety-orange cable colour. */
  accent?: boolean;
  class?: string;
}

const { variant = 'line', size = 24, accent = false, class: className } = Astro.props;
---

{
  variant === 'line' ? (
    <svg
      class:list={['plant', 'plant--line', { 'plant--accent': accent }, className]}
      width={size}
      height={size}
      viewBox="0 0 32 32"
      aria-hidden="true"
    >
      <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
        <path d="M16 29.5V10" />
        <path d="M9 29.5h14" />
        <path d="M15.6 22.4C11 23 6 20.5 4.4 14.2 10 13.6 14.8 16.6 15.6 22.4Z" />
        <path d="M15.6 22.4 7.5 16.3" />
        <path d="M16.4 16.4C21 17 26 14 27.6 7.8 22 7.2 17.2 10.4 16.4 16.4Z" />
        <path d="M16.4 16.4 24.6 10" />
        <path d="M16 9.6C14 8.1 13.4 5.2 16 2.4 18.6 5.2 18 8.1 16 9.6Z" />
      </g>
      <g class="nodes">
        <circle cx="16" cy="22.4" r="1.4" />
        <circle cx="16" cy="16.4" r="1.4" />
      </g>
    </svg>
  ) : (
    <svg class:list={['plant', className]} width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
      <g fill="currentColor" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
        <path d="M16 29.5V10" fill="none" stroke-width="2.4" />
        <path d="M10 29.5h12" fill="none" stroke-width="2.4" />
        <path d="M15.6 22.4C11 23 6 20.5 4.4 14.2 10 13.6 14.8 16.6 15.6 22.4Z" />
        <path d="M16.4 16.4C21 17 26 14 27.6 7.8 22 7.2 17.2 10.4 16.4 16.4Z" />
        <path d="M16 9.6C14 8.1 13.4 5.2 16 2.4 18.6 5.2 18 8.1 16 9.6Z" />
      </g>
    </svg>
  )
}

<style>
  .plant {
    display: block;
    flex: none;
  }
  .plant--line g {
    stroke-width: 1.4px;
    vector-effect: non-scaling-stroke;
  }
  .plant--line path {
    vector-effect: non-scaling-stroke;
  }
  .nodes {
    fill: currentColor;
  }
  .plant--accent .nodes {
    fill: var(--cable);
  }
</style>
