---
/** Section title row: h2 on the left, optional "see all" link on the right. */
interface Props {
  title: string;
  id?: string;
  href?: string;
  linkLabel?: string;
  level?: 'h1' | 'h2';
}
const { title, id, href, linkLabel, level = 'h2' } = Astro.props;
const Heading = level;
---

<div class="section-header">
  <Heading id={id} class="title">{title}</Heading>
  {
    href && linkLabel && (
      <a href={href} class="more">
        {linkLabel}
        <svg class="lead" width="44" height="14" viewBox="0 0 44 14" aria-hidden="true">
          <circle class="pulley" cx="7" cy="7" r="5.5" />
          <circle class="axle" cx="7" cy="7" r="1.6" />
          <path class="cable" d="M7 1.5h30" />
          <path d="M36 2.5l4.5 4.5-4.5 4.5" fill="none" stroke="currentColor" />
        </svg>
      </a>
    )
  }
</div>

<style>
  .section-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 40px;
    font-family: var(--font-display);
  }
  .title {
    margin: 0;
    font-weight: 400;
    font-size: 32px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-size: 15px;
    color: var(--mute);
  }
  .more:hover {
    color: var(--ink);
  }
  /* A short run of cable over a pulley leads into the arrow. */
  .lead {
    overflow: visible;
  }
  .lead .pulley {
    fill: var(--steel);
    stroke: var(--steel-lo);
  }
  .lead .axle {
    fill: var(--steel-hi);
  }
  .lead .cable {
    fill: none;
    stroke: var(--cable);
    stroke-width: 2;
    transition: d 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .more:hover .cable {
    d: path('M7 1.5h33');
  }
</style>
