---
/** Section title row: h2 on the left, optional "see all" link on the right. */
interface Props {
  title: string;
  id?: string;
  href?: string;
  linkLabel?: string;
  level?: 'h1' | 'h2';
}
const { title, id, href, linkLabel, level = 'h2' } = Astro.props;
const Heading = level;
---

<div class="section-header">
  <Heading id={id} class="title">{title}</Heading>
  {
    href && linkLabel && (
      <a href={href} class="more">
        {linkLabel}
        <svg class="lead" width="28" height="12" viewBox="0 0 28 12" aria-hidden="true">
          <path d="M0 6h26M21 1l5 5-5 5" fill="none" stroke="currentColor" />
        </svg>
      </a>
    )
  }
</div>

<style>
  .section-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 40px;
    font-family: var(--font-display);
  }
  .title {
    margin: 0;
    font-weight: 400;
    font-size: 32px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-size: 15px;
    color: var(--mute);
  }
  .more:hover {
    color: var(--ink);
  }
  /* A plain drawn arrow that steps forward on hover or focus. */
  .lead {
    flex: none;
    transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .more:hover .lead,
  .more:focus-visible .lead {
    transform: translateX(4px);
  }
  @media (prefers-reduced-motion: reduce) {
    .lead {
      transition: none;
    }
  }
</style>
