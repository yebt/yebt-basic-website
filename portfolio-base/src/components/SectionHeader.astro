---
/** Section title row: h2 on the left, optional "see all" link on the right. */
interface Props {
  title: string;
  id?: string;
  href?: string;
  linkLabel?: string;
  level?: 'h1' | 'h2';
}
const { title, id, href, linkLabel, level = 'h2' } = Astro.props;
const Heading = level;
---

<div class="section-header">
  <Heading id={id} class="title">{title}</Heading>
  {
    href && linkLabel && (
      <a href={href} class="more">
        {linkLabel}
        <svg class="lead" width="48" height="14" viewBox="0 0 48 14" aria-hidden="true" shape-rendering="crispEdges">
          <rect class="rail" x="0" y="4" width="37" height="6" />
          <rect class="rail-hi" x="0" y="4" width="37" height="1" />
          <rect class="slot" x="0" y="6" width="37" height="2" />
          <rect class="cable" x="0" y="6" width="6" height="2" />
          <g class="carriage">
            <rect class="edge" x="2" y="1" width="8" height="12" />
            <rect class="face" x="3" y="2" width="6" height="10" />
          </g>
          <rect class="edge" x="36" y="1" width="12" height="12" />
          <rect class="cube" x="37" y="2" width="10" height="10" />
          <circle class="hole" cx="42" cy="7" r="2" shape-rendering="geometricPrecision" />
        </svg>
      </a>
    )
  }
</div>

<style>
  .section-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 40px;
    font-family: var(--font-display);
  }
  .title {
    margin: 0;
    font-weight: 400;
    font-size: 32px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-size: 15px;
    color: var(--mute);
  }
  .more:hover {
    color: var(--ink);
  }
  /*
   * A short profile rail ending in a cube connector. On hover or focus the
   * carriage slides along the slot to the cube, drawing the orange cable with it.
   */
  .lead {
    flex: none;
  }
  .rail {
    fill: var(--steel);
  }
  .rail-hi {
    fill: var(--steel-hi);
  }
  .slot,
  .hole {
    fill: var(--slot);
  }
  .edge {
    fill: var(--steel-lo);
  }
  .cube {
    fill: var(--steel);
  }
  .face {
    fill: var(--steel-hi);
  }
  .cable {
    fill: var(--cable);
    transform-box: view-box;
    transform-origin: 0 0;
  }
  .carriage,
  .cable {
    transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .more:hover .carriage,
  .more:focus-visible .carriage {
    transform: translateX(24px);
  }
  .more:hover .cable,
  .more:focus-visible .cable {
    transform: scaleX(5);
  }
  @media (prefers-reduced-motion: reduce) {
    .carriage,
    .cable {
      transition: none;
    }
  }
</style>
