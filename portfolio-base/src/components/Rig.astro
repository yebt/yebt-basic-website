---
/**
 * Profile rig: the few actions that matter stand on an aluminium profile
 * rail, each on a post with a T-nut seated in the rail slot. Machined cube
 * connectors with a bolt hole close both ends; a safety-orange cable runs in
 * the slot and over a tensioner pulley at the far end, which turns when an
 * action is hovered or focused. Every part is a pixel-aligned box, so lines
 * stay crisp and straight at any width.
 * Wide containers: horizontal rail under the actions. Narrow containers
 * (container query): vertical rail on the left, actions stacked.
 * Use it only for the actions that matter (hero, contact).
 */
import { NEW_TAB_HINT, externalAttrs, isExternal } from '../lib/links';

export interface RigAction {
  label: string;
  href: string;
  /** `tube` is the fluorescent primary action; anything else the hairline secondary one. */
  variant?: 'tube' | 'line';
  rel?: string;
  target?: string;
  download?: boolean;
  /** Visually hidden suffix for the accessible name, e.g. "(opens in a new tab)". */
  hint?: string;
}

interface Props {
  actions: RigAction[];
  /** Accessible name for the list of actions. */
  label: string;
  class?: string;
}

const { actions, label, class: className } = Astro.props;
---

<div class:list={['rig', className]}>
  <div class="frame">
    <ul aria-label={label}>
      {
        actions.map((action) => (
          <li>
            <a
              class={action.variant === 'tube' ? 'tube' : 'btn'}
              href={action.href}
              download={action.download ? '' : undefined}
              {...{ target: action.target, ...externalAttrs(action.href, action.rel) }}
            >
              {action.label}
              {(action.hint ?? (isExternal(action.href) ? NEW_TAB_HINT : undefined)) && (
                <span class="sr-only"> {action.hint ?? NEW_TAB_HINT}</span>
              )}
            </a>
          </li>
        ))
      }
    </ul>
    <span class="rail" aria-hidden="true"></span>
    <span class="cube cube--start" aria-hidden="true"></span>
    <span class="cube cube--end" aria-hidden="true"></span>
    <svg class="tensioner" width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
      <rect class="bracket" x="0" y="8" width="6" height="6" />
      <g class="wheel">
        <circle cx="13" cy="11" r="8.5" />
        <path d="M13 11V3M13 11l6.9 4M13 11l-6.9 4" />
        <circle class="hub" cx="13" cy="11" r="2" />
      </g>
    </svg>
  </div>
</div>

<style>
  .rig {
    container: rig / inline-size;
    /* Rail geometry, in whole pixels so every edge lands on the pixel grid. */
    --rail: 9px;
    --cube: 15px;
    --post: 10px;
  }
  .frame {
    position: relative;
    padding: 0 0 calc(var(--rail) + var(--post));
  }
  ul {
    display: flex;
    gap: 16px;
    margin: 0;
    padding: 0 calc(var(--cube) + 14px);
    list-style: none;
  }
  li {
    position: relative;
  }
  /* Post from the action down to the rail, and the T-nut seated in the slot. */
  li::before,
  li::after {
    content: '';
    position: absolute;
    left: 50%;
    pointer-events: none;
  }
  li::before {
    top: 100%;
    width: 2px;
    height: var(--post);
    margin-left: -1px;
    background: var(--steel);
  }
  li::after {
    top: calc(100% + var(--post) - 2px);
    width: 14px;
    height: 5px;
    margin-left: -7px;
    background: var(--steel-hi);
    border: 1px solid var(--steel-lo);
    transition:
      background-color 200ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  li:hover::after,
  li:focus-within::after {
    background: var(--cable);
    border-color: var(--cable-lo);
  }
  li :global(.btn),
  li :global(.tube) {
    min-height: 48px;
    padding: 0 18px;
    font-size: 15px;
    white-space: nowrap;
    background-color: var(--veil);
  }
  li :global(.tube) {
    padding: 0 22px;
    background-color: var(--tube);
  }

  /*
   * Aluminium profile: bright top edge, flat face, the dark T-slot with the
   * orange cable inside it, a shaded lower face.
   */
  .rail {
    position: absolute;
    left: calc(var(--cube) / 2);
    right: calc(var(--cube) / 2);
    bottom: 0;
    height: var(--rail);
    background: linear-gradient(
      to bottom,
      var(--steel-hi) 0 1px,
      var(--steel) 1px 3px,
      var(--slot) 3px 4px,
      var(--cable) 4px 5px,
      var(--slot) 5px 6px,
      var(--steel) 6px 8px,
      var(--steel-lo) 8px 9px
    );
  }
  /* Machined cube connector with a bolt hole, at each end of the rail. */
  .cube {
    position: absolute;
    bottom: calc((var(--rail) - var(--cube)) / 2);
    width: var(--cube);
    height: var(--cube);
    border: 1px solid var(--steel-lo);
    background:
      radial-gradient(circle at 50% 50%, var(--slot) 0 2.5px, var(--steel-lo) 3px 3.5px, transparent 4px),
      linear-gradient(135deg, var(--steel-hi), var(--steel) 60%, var(--steel-lo));
  }
  .cube--start {
    left: 0;
  }
  .cube--end {
    right: 0;
  }
  /* Tensioner pulley on a bracket past the end cube; turns while an action is engaged. */
  .tensioner {
    position: absolute;
    right: -21px;
    bottom: -6px;
    overflow: visible;
  }
  .bracket {
    fill: var(--steel-lo);
  }
  .wheel {
    fill: var(--steel);
    stroke: var(--steel-lo);
    stroke-width: 1;
    transform-box: view-box;
    transform-origin: 13px 11px;
    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .wheel path {
    fill: none;
    stroke: var(--steel-hi);
  }
  .wheel .hub {
    fill: var(--slot);
    stroke: var(--cable);
    stroke-width: 1.5;
  }
  .rig:has(a:hover, a:focus-visible) .wheel {
    transform: rotate(180deg);
  }

  @container rig (max-width: 470px) {
    .frame {
      padding: 0 0 0 calc(var(--rail) + var(--post));
    }
    ul {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      padding: calc(var(--cube) + 10px) 0;
    }
    li::before {
      top: 50%;
      left: auto;
      right: 100%;
      width: var(--post);
      height: 2px;
      margin: -1px 0 0;
    }
    li::after {
      top: 50%;
      left: auto;
      right: calc(100% + var(--post) - 2px);
      width: 5px;
      height: 14px;
      margin: -7px 0 0;
    }
    .rail {
      top: calc(var(--cube) / 2);
      bottom: calc(var(--cube) / 2);
      left: 0;
      right: auto;
      width: var(--rail);
      height: auto;
      background: linear-gradient(
        to right,
        var(--steel-hi) 0 1px,
        var(--steel) 1px 3px,
        var(--slot) 3px 4px,
        var(--cable) 4px 5px,
        var(--slot) 5px 6px,
        var(--steel) 6px 8px,
        var(--steel-lo) 8px 9px
      );
    }
    .cube {
      left: calc((var(--rail) - var(--cube)) / 2);
      right: auto;
      bottom: auto;
    }
    .cube--start {
      top: 0;
    }
    .cube--end {
      bottom: 0;
    }
    .tensioner {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wheel,
    li::after {
      transition: none;
    }
  }
</style>
