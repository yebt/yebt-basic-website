---
/**
 * Cable rig: a safety-orange cable runs over two steel pulleys on bolted
 * anchor plates, and each action hangs from it on a short drop with a clamp.
 * The first action can be a fluorescent tube. Wide containers: horizontal
 * rail. Narrow containers (container query): vertical rail on the left with
 * horizontal drops, so actions never wrap under the rail.
 * Use it only for the few actions that matter (hero, contact).
 */
export interface RigAction {
  label: string;
  href: string;
  /** `tube` is the fluorescent primary action; `line` the hairline secondary one. */
  variant?: 'tube' | 'line';
  rel?: string;
  download?: boolean;
}

interface Props {
  actions: RigAction[];
  /** Accessible name for the list of actions. */
  label: string;
  class?: string;
}

const { actions, label, class: className } = Astro.props;
---

<div class:list={['rig', className]}>
  <div class="frame">
  {
    ['start', 'end'].map((end) => (
      <svg class={`pulley pulley--${end}`} width="30" height="30" viewBox="0 0 30 30" aria-hidden="true">
        <rect class="plate" x="1.5" y="2.5" width="12" height="25" />
        <circle class="bolt" cx="7.5" cy="7" r="1.6" />
        <circle class="bolt" cx="7.5" cy="23" r="1.6" />
        <rect class="arm" x="7" y="13" width="13" height="4" />
        <circle class="wheel" cx="20" cy="15" r="8" />
        <circle class="groove" cx="20" cy="15" r="5.2" />
        <circle class="bolt" cx="20" cy="15" r="1.8" />
        <path class="wire" d="M31 7H20a8 8 0 0 0-8 8v15" />
      </svg>
    ))
  }
  <ul aria-label={label}>
    {
      actions.map((action) => (
        <li>
          <a
            class={action.variant === 'tube' ? 'tube' : 'btn'}
            href={action.href}
            rel={action.rel}
            download={action.download ? '' : undefined}
          >
            {action.label}
          </a>
        </li>
      ))
    }
  </ul>
  </div>
</div>

<style>
  .rig {
    container: rig / inline-size;
  }
  .frame {
    position: relative;
    padding-top: 34px;
  }
  /* The rail: one cable between the two pulleys. */
  .frame::before {
    content: '';
    position: absolute;
    top: 6px;
    left: 30px;
    right: 30px;
    height: 2px;
    background: var(--cable);
    box-shadow: 0 1px 0 var(--cable-lo);
  }
  .pulley {
    position: absolute;
    top: -1px;
    overflow: visible;
  }
  .pulley--start {
    left: 0;
  }
  .pulley--end {
    right: 0;
    transform: scaleX(-1);
  }
  .plate {
    fill: var(--steel-lo);
    stroke: var(--steel);
  }
  .arm,
  .wheel {
    fill: var(--steel);
    stroke: var(--steel-lo);
  }
  .groove {
    fill: none;
    stroke: var(--steel-lo);
    stroke-width: 1.5;
  }
  .bolt {
    fill: var(--steel-hi);
  }
  .wire {
    fill: none;
    stroke: var(--cable);
    stroke-width: 2;
  }
  ul {
    display: flex;
    gap: 16px;
    margin: 0;
    padding: 0 32px;
    list-style: none;
  }
  li {
    position: relative;
  }
  /* Drop from the rail to the action, and the clamp that holds it. */
  li::before,
  li::after {
    content: '';
    position: absolute;
    left: 50%;
  }
  li::before {
    top: -26px;
    width: 2px;
    height: 26px;
    margin-left: -1px;
    background: var(--cable);
  }
  li::after {
    top: -7px;
    width: 10px;
    height: 7px;
    margin-left: -5px;
    background: var(--steel);
    border: 1px solid var(--steel-lo);
  }
  li :global(.btn),
  li :global(.tube) {
    min-height: 48px;
    padding: 0 18px;
    font-size: 15px;
    white-space: nowrap;
    background-color: var(--veil);
  }
  li :global(.tube) {
    padding: 0 22px;
    background-color: var(--tube);
  }

  @container rig (max-width: 470px) {
    .frame {
      padding: 0 0 0 34px;
    }
    .frame::before {
      top: 30px;
      bottom: 30px;
      left: 6px;
      right: auto;
      width: 2px;
      height: auto;
      box-shadow: 1px 0 0 var(--cable-lo);
    }
    .pulley--start {
      left: -1px;
      top: 0;
      transform: rotate(90deg) scaleY(-1);
    }
    .pulley--end {
      left: -1px;
      right: auto;
      top: auto;
      bottom: 0;
      transform: rotate(-90deg);
    }
    ul {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
      padding: 36px 0;
    }
    li::before {
      top: 50%;
      left: -26px;
      width: 26px;
      height: 2px;
      margin: -1px 0 0;
    }
    li::after {
      top: 50%;
      left: -7px;
      width: 7px;
      height: 10px;
      margin: -5px 0 0;
    }
  }
</style>
