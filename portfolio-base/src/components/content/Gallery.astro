---
/**
 * Page gallery viewer. Collage cuts and figure images are links carrying
 * `data-gallery-*` (see gallery-image.ts); a click or Enter on one opens this
 * native <dialog> with every inspectable image on the page in document order,
 * starting at that one. Prev/next buttons, arrow keys, Home/End, touch swipe,
 * thumbnails and a fit / 100% toggle. Escape or the close button returns focus
 * to the trigger; the page does not scroll while it is open. Without JS the
 * links simply open the large image file. Render once per page.
 */
---

<dialog class="viewer" aria-labelledby="gallery-title" data-gallery-viewer>
  <div class="shell">
    <header class="bar">
      <h2 class="title" id="gallery-title">
        <span class="title-fig" data-g-figure></span>
        <span class="title-label" data-g-label></span>
      </h2>
      <p class="count" data-g-count></p>
      <div class="tools">
        <button class="tool" type="button" data-g-zoom aria-pressed="false">100%</button>
        <button class="tool tool--icon" type="button" data-g-close aria-label="Close viewer">
          <svg viewBox="0 0 14 14" width="14" height="14" aria-hidden="true"><path d="M2 2l10 10M12 2 2 12"></path></svg>
        </button>
      </div>
    </header>

    <div class="stage" data-g-stage>
      <div class="canvas" data-g-canvas></div>
      <span class="loading" aria-hidden="true"></span>
      <button class="nav nav--prev" type="button" data-g-prev aria-label="Previous image">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M10.5 2.5 5 8l5.5 5.5"></path></svg>
      </button>
      <button class="nav nav--next" type="button" data-g-next aria-label="Next image">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M5.5 2.5 11 8l-5.5 5.5"></path></svg>
      </button>
    </div>

    <p class="caption" data-g-caption></p>
    <ol class="thumbs" data-g-thumbs aria-label="All images on this page"></ol>
    <p class="sr-only" aria-live="polite" data-g-live></p>
  </div>
</dialog>

<script>
  import { collectItems, counterLabel, swipeDirection, wrapIndex, type GalleryItem } from '../../lib/gallery';

  const dialog = document.querySelector<HTMLDialogElement>('[data-gallery-viewer]');

  if (dialog) {
    const $ = <T extends Element>(sel: string) => dialog.querySelector<T>(sel)!;
    const stage = $<HTMLElement>('[data-g-stage]');
    const canvas = $<HTMLElement>('[data-g-canvas]');
    // The viewer image is created here so the markup never ships an image without a source.
    const img = document.createElement('img');
    img.alt = '';
    img.decoding = 'async';
    img.sizes = '(max-width: 900px) 100vw, 86vw';
    canvas.append(img);
    const figureEl = $<HTMLElement>('[data-g-figure]');
    const labelEl = $<HTMLElement>('[data-g-label]');
    const countEl = $<HTMLElement>('[data-g-count]');
    const captionEl = $<HTMLElement>('[data-g-caption]');
    const thumbs = $<HTMLOListElement>('[data-g-thumbs]');
    const live = $<HTMLElement>('[data-g-live]');
    const zoom = $<HTMLButtonElement>('[data-g-zoom]');
    const prevBtn = $<HTMLButtonElement>('[data-g-prev]');
    const nextBtn = $<HTMLButtonElement>('[data-g-next]');

    let items: GalleryItem[] = [];
    let triggers: HTMLElement[] = [];
    let index = 0;
    let opener: HTMLElement | null = null;
    let actual = false;

    const setZoom = (on: boolean) => {
      actual = on;
      stage.classList.toggle('is-actual', on);
      zoom.setAttribute('aria-pressed', String(on));
      zoom.textContent = on ? 'Fit' : '100%';
      zoom.setAttribute('aria-label', on ? 'Fit image to the screen' : 'Show image at 100%');
      if (on) {
        // Start at the centre of the full-size image.
        requestAnimationFrame(() => {
          canvas.scrollLeft = (canvas.scrollWidth - canvas.clientWidth) / 2;
          canvas.scrollTop = (canvas.scrollHeight - canvas.clientHeight) / 2;
        });
      }
    };

    const preload = (item: GalleryItem | undefined) => {
      if (!item) return;
      const probe = new Image();
      probe.sizes = img.sizes;
      if (item.srcset) probe.srcset = item.srcset;
      probe.src = item.src;
    };

    const show = (i: number) => {
      index = wrapIndex(i, items.length);
      const item = items[index];
      stage.classList.add('is-loading');
      img.removeAttribute('srcset');
      if (item.width && item.height) {
        img.width = item.width;
        img.height = item.height;
      }
      if (item.srcset) img.srcset = item.srcset;
      img.src = item.src;
      img.alt = item.alt;
      if (img.complete && img.naturalWidth) stage.classList.remove('is-loading');

      figureEl.textContent = item.figure;
      figureEl.hidden = !item.figure || item.figure === item.label;
      labelEl.textContent = item.label || item.alt;
      countEl.textContent = counterLabel(index, items.length);
      captionEl.textContent = item.caption || item.alt;
      live.textContent = `Image ${index + 1} of ${items.length}: ${item.label ? `${item.label}, ` : ''}${item.alt}`;

      thumbs.querySelectorAll('button').forEach((b, k) => {
        if (k === index) {
          b.setAttribute('aria-current', 'true');
          b.scrollIntoView({ block: 'nearest', inline: 'nearest' });
        } else b.removeAttribute('aria-current');
      });
      const single = items.length < 2;
      prevBtn.hidden = single;
      nextBtn.hidden = single;
      thumbs.hidden = single;
      setZoom(false);
      preload(items[wrapIndex(index + 1, items.length)]);
      preload(items[wrapIndex(index - 1, items.length)]);
    };

    const buildThumbs = () => {
      thumbs.replaceChildren(
        ...items.map((item, k) => {
          const li = document.createElement('li');
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'thumb';
          b.setAttribute('aria-label', `Show image ${k + 1}: ${item.label || item.alt}`);
          const t = document.createElement('img');
          t.src = item.thumb;
          t.alt = '';
          t.loading = 'lazy';
          t.decoding = 'async';
          b.append(t);
          b.addEventListener('click', () => show(k));
          li.append(b);
          return li;
        }),
      );
    };

    let scrollbar = 0;
    const lockScroll = (on: boolean) => {
      const root = document.documentElement;
      if (on) {
        scrollbar = window.innerWidth - root.clientWidth;
        root.classList.add('gallery-open');
        root.style.setProperty('--gallery-scrollbar', `${scrollbar}px`);
      } else {
        root.classList.remove('gallery-open');
        root.style.removeProperty('--gallery-scrollbar');
      }
    };

    const open = (trigger: HTMLElement) => {
      ({ items, triggers } = collectItems<HTMLElement>(document));
      const start = triggers.indexOf(trigger);
      if (start < 0) return;
      opener = trigger;
      buildThumbs();
      lockScroll(true);
      dialog.showModal();
      show(start);
      dialog.querySelector<HTMLElement>('[data-g-close]')?.focus();
    };

    img.addEventListener('load', () => stage.classList.remove('is-loading'));
    img.addEventListener('error', () => stage.classList.remove('is-loading'));

    document.addEventListener('click', (event) => {
      if (event.defaultPrevented || event.button !== 0) return;
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const trigger = (event.target as Element | null)?.closest<HTMLElement>('[data-gallery-full]');
      if (!trigger || dialog.contains(trigger)) return;
      event.preventDefault();
      open(trigger);
    });

    prevBtn.addEventListener('click', () => show(index - 1));
    nextBtn.addEventListener('click', () => show(index + 1));
    zoom.addEventListener('click', () => setZoom(!actual));
    $<HTMLButtonElement>('[data-g-close]').addEventListener('click', () => dialog.close());

    // A click on the backdrop (outside the panel) closes.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.altKey || event.ctrlKey || event.metaKey) return;
      const keys: Record<string, () => void> = {
        ArrowRight: () => show(index + 1),
        ArrowLeft: () => show(index - 1),
        Home: () => show(0),
        End: () => show(items.length - 1),
      };
      // At 100% the arrows scroll the image instead.
      if (actual && (event.key === 'ArrowRight' || event.key === 'ArrowLeft')) return;
      const run = keys[event.key];
      if (run && items.length > 1) {
        event.preventDefault();
        run();
      }
    });

    let startX = 0;
    let startY = 0;
    let tracking = false;
    stage.addEventListener('pointerdown', (event) => {
      if (actual || event.pointerType === 'mouse') return;
      tracking = true;
      startX = event.clientX;
      startY = event.clientY;
    });
    stage.addEventListener('pointerup', (event) => {
      if (!tracking) return;
      tracking = false;
      const dir = swipeDirection(event.clientX - startX, event.clientY - startY);
      if (dir && items.length > 1) show(index + (dir === 'next' ? 1 : -1));
    });
    stage.addEventListener('pointercancel', () => (tracking = false));

    dialog.addEventListener('close', () => {
      lockScroll(false);
      setZoom(false);
      img.removeAttribute('srcset');
      img.removeAttribute('src');
      opener?.focus({ preventScroll: true });
      opener = null;
    });
  }
</script>

<style>
  :global(html.gallery-open) {
    overflow: hidden;
  }
  :global(html.gallery-open body) {
    padding-right: var(--gallery-scrollbar, 0px);
  }

  .viewer {
    --g-ground: #0b0c0c;
    --g-on-ground: #ecece6;
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: var(--module-inset);
    border: 0;
    background: transparent;
    color: var(--ink);
    overflow: hidden;
  }
  .viewer::backdrop {
    background: rgba(8, 9, 8, 0.66);
    backdrop-filter: blur(6px);
  }

  .shell {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto auto;
    width: 100%;
    max-width: 1680px;
    height: 100%;
    margin: 0 auto;
    border: 1px solid var(--line-strong);
    background: linear-gradient(to bottom, var(--acrylic-light), transparent 140px), var(--acrylic);
    backdrop-filter: blur(16px) saturate(1.1);
    box-shadow:
      inset 0 1px 0 var(--acrylic-edge),
      0 28px 60px -24px var(--module-shadow);
  }

  .bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 16px;
    padding: 12px 12px 12px 18px;
    border-bottom: 1px solid var(--line);
  }
  .title {
    display: flex;
    align-items: baseline;
    gap: 12px;
    min-width: 0;
    margin: 0;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .title-fig {
    flex: none;
    font-family: var(--font-display);
    letter-spacing: 0.06em;
    color: var(--mute);
  }
  .title-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .count {
    margin: 0;
    font-family: var(--font-display);
    font-size: 15px;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
  }
  .tools {
    display: flex;
    gap: 8px;
  }
  .tool {
    min-width: 44px;
    height: 36px;
    padding: 0 12px;
    border: 1px solid var(--line-strong);
    background: var(--slab);
    font-family: var(--font-body);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .tool--icon {
    display: grid;
    place-items: center;
    padding: 0;
  }
  .tool svg,
  .nav svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }
  .tool:hover,
  .nav:hover {
    border-color: var(--cable);
  }
  .tool[aria-pressed='true'] {
    border-color: var(--cable);
    color: var(--cable);
  }

  /* The image sits on the same near-black print ground as the collages. */
  .stage {
    position: relative;
    min-height: 0;
    background:
      linear-gradient(var(--line), var(--line)) 50% 0 / 1px 10px no-repeat,
      linear-gradient(var(--line), var(--line)) 50% 100% / 1px 10px no-repeat,
      var(--g-ground);
    touch-action: pan-y pinch-zoom;
  }
  .canvas {
    display: grid;
    /* Definite track sizes so the image's max-width/max-height resolve. */
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    place-items: center;
    width: 100%;
    height: 100%;
    padding: clamp(12px, 2.4vw, 32px) clamp(12px, 5vw, 72px);
    overflow: hidden;
  }
  .canvas :global(img) {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    box-shadow: 0 18px 40px -22px rgba(0, 0, 0, 0.9);
    cursor: zoom-in;
  }
  .stage.is-actual .canvas {
    grid-template: auto / auto;
    place-items: start;
    overflow: auto;
    overscroll-behavior: contain;
  }
  .stage.is-actual .canvas :global(img) {
    max-width: none;
    max-height: none;
    margin: auto;
    cursor: default;
  }
  .stage.is-loading .canvas :global(img) {
    opacity: 0;
  }
  /* Loading: a short safety-orange cable runs along the top edge. */
  .loading {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(to right, transparent, var(--cable) 40%, var(--cable) 60%, transparent) 0 0 / 30% 100% no-repeat;
    opacity: 0;
    pointer-events: none;
  }
  .stage.is-loading .loading {
    opacity: 1;
  }

  .nav {
    position: absolute;
    top: 50%;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-top: -22px;
    border: 1px solid rgba(236, 236, 230, 0.26);
    background: rgba(11, 12, 12, 0.72);
    color: var(--g-on-ground);
  }
  .nav--prev {
    left: 10px;
  }
  .nav--next {
    right: 10px;
  }
  .nav:focus-visible {
    outline-color: var(--g-on-ground);
    outline-offset: 2px;
  }
  .nav[hidden] {
    display: none;
  }

  .caption {
    max-height: calc(4.8em + 12px);
    margin: 0;
    padding: 12px 18px 0;
    overflow: auto;
    font-size: 13px;
    line-height: 1.6;
    color: var(--mute);
  }
  .caption:empty {
    display: none;
  }

  .thumbs {
    display: flex;
    gap: 8px;
    margin: 0;
    padding: 12px 18px 14px;
    overflow-x: auto;
    list-style: none;
    scrollbar-width: thin;
  }
  .thumbs[hidden] {
    display: none;
  }
  .thumbs :global(.thumb) {
    display: block;
    width: 64px;
    height: 48px;
    padding: 0;
    border: 1px solid var(--line-strong);
    background: var(--g-ground);
  }
  .thumbs :global(.thumb img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.5;
  }
  .thumbs :global(.thumb:hover img) {
    opacity: 0.85;
  }
  .thumbs :global(.thumb[aria-current='true']) {
    border-color: var(--cable);
    box-shadow: 0 0 0 1px var(--cable);
  }
  .thumbs :global(.thumb[aria-current='true'] img) {
    opacity: 1;
  }

  @media (max-width: 640px) {
    .viewer {
      padding: 0;
    }
    .shell {
      border: 0;
    }
    .bar {
      grid-template-columns: minmax(0, 1fr) auto;
      row-gap: 4px;
      padding: 8px 8px 8px 14px;
    }
    .title {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .count {
      grid-row: 1;
    }
    .nav {
      top: auto;
      bottom: 10px;
      margin-top: 0;
    }
    .caption,
    .thumbs {
      padding-left: 14px;
      padding-right: 14px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .viewer[open] .shell {
      transition:
        opacity 260ms cubic-bezier(0.16, 1, 0.3, 1),
        transform 260ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    @starting-style {
      .viewer[open] .shell {
        opacity: 0;
        transform: translateY(12px) scale(0.985);
      }
    }
    .canvas :global(img) {
      transition: opacity 240ms ease-out;
    }
    .stage.is-loading .loading {
      animation: cable-run 900ms linear infinite;
    }
    @keyframes cable-run {
      from {
        background-position: -40% 0;
      }
      to {
        background-position: 140% 0;
      }
    }
  }
</style>
