---
/**
 * Single image with a caption for MDX content. `wide` spans into the side
 * column on wide screens. Images go through Astro's <Image> (responsive, lazy).
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** Figure number shown before the caption, e.g. "FIG. 01". */
  figure?: string;
  wide?: boolean;
}

const { src, alt, caption, figure, wide = false } = Astro.props;
---

<figure class:list={['figure', { wide }]}>
  <div class="frame">
    <Image src={src} alt={alt} widths={[480, 800, 1200]} sizes="(max-width: 820px) 100vw, 760px" />
  </div>
  {
    (caption || figure) && (
      <figcaption>
        {figure && <span class="fig">{figure}</span>}
        <span>{caption}</span>
      </figcaption>
    )
  }
</figure>

<style>
  .figure {
    margin: 2.4em 0;
  }
  .frame {
    position: relative;
    border: 1px solid var(--line-strong);
    background: var(--slab);
  }
  /* Registration marks on the two top corners, like a print proof. */
  .frame::before,
  .frame::after {
    content: '';
    position: absolute;
    top: -9px;
    width: 1px;
    height: 17px;
    background: var(--mute);
  }
  .frame::before {
    left: 12px;
  }
  .frame::after {
    right: 12px;
  }
  .frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  figcaption {
    display: flex;
    gap: 14px;
    margin-top: 12px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--mute);
  }
  .fig {
    flex: none;
    font-family: var(--font-display);
    letter-spacing: 0.06em;
    color: var(--ink);
  }
</style>
