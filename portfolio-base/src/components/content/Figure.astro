---
/**
 * Single image with a caption for MDX content. `wide` spans into the side
 * column on wide screens. Images go through Astro's <Image> (responsive, lazy).
 * The image links to its large variant and opens in the page gallery viewer;
 * `inspect={false}` keeps it static.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import InspectCue from './InspectCue.astro';
import { galleryAttrs } from './gallery-image';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** Figure number shown before the caption, e.g. "FIG. 01". */
  figure?: string;
  wide?: boolean;
  /** Opens in the page gallery viewer (default). */
  inspect?: boolean;
}

const { src, alt, caption, figure, wide = false, inspect = true } = Astro.props;
const link = inspect ? await galleryAttrs(src, { alt, label: figure, caption, figure }) : null;
const name = figure ? `Inspect ${figure}: ${alt}` : `Inspect image: ${alt}`;
---

<figure class:list={['figure', { wide }]}>
  {
    link ? (
      <a class="frame frame--inspect" aria-label={name} aria-haspopup="dialog" {...link}>
        <Image src={src} alt="" widths={[480, 800, 1200]} sizes="(max-width: 820px) 100vw, 760px" />
        <InspectCue label={figure} />
      </a>
    ) : (
      <div class="frame">
        <Image src={src} alt={alt} widths={[480, 800, 1200]} sizes="(max-width: 820px) 100vw, 760px" />
      </div>
    )
  }
  {
    (caption || figure) && (
      <figcaption>
        {figure && <span class="fig">{figure}</span>}
        <span>{caption}</span>
      </figcaption>
    )
  }
</figure>

<style>
  .figure {
    margin: 2.4em 0;
  }
  .frame {
    position: relative;
    border: 1px solid var(--line-strong);
    background: var(--slab);
  }
  /* Registration marks on the two top corners, like a print proof. */
  .frame::before,
  .frame::after {
    content: '';
    position: absolute;
    top: -9px;
    width: 1px;
    height: 17px;
    background: var(--mute);
  }
  .frame::before {
    left: 12px;
  }
  .frame::after {
    right: 12px;
  }
  .frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .frame--inspect {
    display: block;
    cursor: zoom-in;
    outline-offset: 4px;
  }
  .frame--inspect:is(:hover, :focus-visible) {
    border-color: var(--cable);
    box-shadow: 0 16px 28px -16px rgba(0, 0, 0, 0.6);
    transform: translateY(-2px);
  }
  .frame--inspect:is(:hover, :focus-visible) :global(img) {
    filter: brightness(1.06);
  }
  .frame--inspect:is(:hover, :focus-visible) :global(.inspect-cue) {
    opacity: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .frame--inspect,
    .frame--inspect :global(img),
    .frame--inspect :global(.inspect-cue) {
      transition:
        transform 220ms cubic-bezier(0.16, 1, 0.3, 1),
        box-shadow 220ms cubic-bezier(0.16, 1, 0.3, 1),
        border-color 160ms ease-out,
        filter 220ms ease-out,
        opacity 160ms ease-out;
    }
  }
  @media (hover: none) {
    .frame--inspect :global(.inspect-cue) {
      opacity: 0.86;
    }
    .frame--inspect :global(.inspect-cue span) {
      display: none;
    }
  }
  figcaption {
    display: flex;
    gap: 14px;
    margin-top: 12px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--mute);
  }
  .fig {
    flex: none;
    font-family: var(--font-display);
    letter-spacing: 0.06em;
    color: var(--ink);
  }
</style>
