---
/**
 * Fixed full-viewport ASCII portrait. Cells resolve 40 -> 6 px in small
 * geometric steps; each step crossfades over the previous one and the
 * character ramp grows from 4 characters to the full ramp. The canvas fades
 * in once the portrait has loaded. Reduced motion: final frame, no fades.
 */
import { getImage } from 'astro:assets';
import portrait from '../assets/portrait.jpg';

const source = await getImage({ src: portrait, width: 320, format: 'webp' });
---

<canvas class="ascii" aria-hidden="true" data-ascii data-src={source.src}></canvas>

<style>
  .ascii {
    position: fixed;
    inset: 0;
    z-index: 0;
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
  }
  .ascii.is-ready {
    opacity: 1;
    transition: opacity 800ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    .ascii.is-ready {
      transition: none;
    }
  }
</style>

<script>
  import {
    CROSSFADE_MS,
    STEPS,
    STEP_MS,
    charFor,
    colorFor,
    easeOut,
    gridSize,
    intensity,
    luminance,
    portraitPlacement,
    rampForStep,
  } from '../lib/ascii';

  const canvas = document.querySelector<HTMLCanvasElement>('canvas[data-ascii]');
  const ctx = canvas?.getContext('2d');

  if (canvas && ctx && canvas.dataset.src) {
    const img = new Image();
    const src = document.createElement('canvas');
    const lo = document.createElement('canvas');
    const sm = document.createElement('canvas');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const last = STEPS.length - 1;

    // Two full-resolution frames: the one fully on screen and the one fading in over it.
    let shown = document.createElement('canvas');
    let incoming: HTMLCanvasElement | null = null;
    let spare = document.createElement('canvas');
    let current = 0;
    let raf = 0;

    const isDark = () => document.documentElement.dataset.theme !== 'light';
    const ready = () => img.complete && img.naturalWidth > 0;

    /** Renders step `index` (blurred photo + characters) into `frame` at device resolution. */
    const render = (frame: HTMLCanvasElement, index: number): boolean => {
      const W = canvas.clientWidth;
      const H = canvas.clientHeight;
      const f = frame.getContext('2d');
      if (!W || !H || !f || !ready()) return false;
      const size = STEPS[index];
      const ramp = rampForStep(index, STEPS.length);
      const dark = isDark();
      const bg =
        getComputedStyle(document.documentElement).getPropertyValue('--bg').trim() || (dark ? '#0b0c0b' : '#e5e4df');
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      frame.width = Math.round(W * dpr);
      frame.height = Math.round(H * dpr);
      f.setTransform(dpr, 0, 0, dpr, 0, 0);

      // 1. Composite the photo onto a viewport-sized source.
      src.width = W;
      src.height = H;
      const s = src.getContext('2d');
      if (!s) return false;
      s.fillStyle = bg;
      s.fillRect(0, 0, W, H);
      const place = portraitPlacement(W, H);
      s.filter = dark ? 'none' : 'grayscale(0.15) contrast(1.05)';
      s.drawImage(img, place.x, place.y, place.size, place.size);
      s.filter = 'none';

      // 2. Low-res blurred photo underneath the characters.
      lo.width = 40;
      lo.height = Math.max(1, Math.round((40 * H) / W));
      lo.getContext('2d')?.drawImage(src, 0, 0, lo.width, lo.height);
      f.fillStyle = bg;
      f.fillRect(0, 0, W, H);
      f.save();
      f.imageSmoothingEnabled = true;
      f.filter = dark ? 'blur(22px) brightness(0.5) saturate(0.8)' : 'blur(22px) brightness(1.08) saturate(0.55)';
      f.globalAlpha = dark ? 1 : 0.6;
      f.drawImage(lo, -40, -40, W + 80, H + 80);
      f.restore();

      // 3. One character per cell, sampled from a cols x rows downscale.
      const { cols, rows } = gridSize(W, H, size);
      sm.width = cols;
      sm.height = rows;
      const g = sm.getContext('2d', { willReadFrequently: true });
      if (!g) return false;
      g.drawImage(src, 0, 0, cols, rows);
      const data = g.getImageData(0, 0, cols, rows).data;
      f.font = `${Math.max(5, Math.round(size * 0.8))}px "Geist Mono", monospace`;
      f.textAlign = 'center';
      f.textBaseline = 'middle';
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const i = (r * cols + c) * 4;
          const R = data[i];
          const G = data[i + 1];
          const B = data[i + 2];
          const lum = luminance(R, G, B);
          const ch = charFor(lum, ramp, dark);
          if (ch === ' ') continue;
          f.fillStyle = colorFor(R, G, B, intensity(lum, dark), dark);
          f.fillText(ch, c * size + size / 2, r * size + size / 2);
        }
      }
      return true;
    };

    /** Paints the shown frame, plus the incoming one at `alpha`, onto the visible canvas. */
    const composite = (alpha: number) => {
      if (canvas.width !== shown.width || canvas.height !== shown.height) {
        canvas.width = shown.width;
        canvas.height = shown.height;
      }
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.globalAlpha = 1;
      ctx.drawImage(shown, 0, 0);
      if (incoming && alpha > 0) {
        ctx.globalAlpha = alpha;
        ctx.drawImage(incoming, 0, 0, canvas.width, canvas.height);
        ctx.globalAlpha = 1;
      }
    };

    /** Makes the incoming frame the shown one and recycles the old shown frame. */
    const commit = () => {
      if (!incoming) return;
      spare = shown;
      shown = incoming;
      incoming = null;
    };

    /** Redraws the current step at once (resize, theme change, reduced motion). */
    const redraw = () => {
      incoming = null;
      if (render(shown, current)) composite(0);
    };

    const play = () => {
      cancelAnimationFrame(raf);
      if (reduceMotion.matches) {
        current = last;
        redraw();
        return;
      }
      current = 0;
      redraw();
      let t0 = 0;
      let fadeStart = 0;
      const frame = (now: number) => {
        if (!t0) t0 = now;
        const target = Math.min(last, Math.floor((now - t0) / STEP_MS));
        if (target !== current) {
          commit();
          current = target;
          if (render(spare, current)) {
            incoming = spare;
            fadeStart = now;
          }
        }
        const alpha = incoming ? easeOut((now - fadeStart) / CROSSFADE_MS) : 0;
        composite(alpha);
        if (incoming && alpha >= 1) {
          commit();
          composite(0);
        }
        if (current < last || incoming) raf = requestAnimationFrame(frame);
      };
      raf = requestAnimationFrame(frame);
    };

    let resizeTimer: number | undefined;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(redraw, 150);
    });

    new MutationObserver(redraw).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });

    img.addEventListener('load', () => {
      const fontReady = document.fonts ? document.fonts.load('10px "Geist Mono"').catch(() => undefined) : Promise.resolve();
      fontReady.then(() => {
        play();
        canvas.classList.add('is-ready');
      });
    });
    img.src = canvas.dataset.src;
  }
</script>
