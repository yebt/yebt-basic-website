---
/**
 * Editorial reading layout for entry bodies. The container decides:
 * - wide (>= 1180px): contents rail | reading column (~65ch) | side column,
 *   with sidenotes floating into the side column and `wide` figures spanning it;
 * - medium (>= 900px): reading column | side column, contents above the text;
 * - narrow: one column, sidenotes inline, contents above the text.
 * It also hosts the page gallery viewer for collage cuts and figures.
 */
import Gallery from '../content/Gallery.astro';
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const toc = Astro.props.headings.filter((h) => h.depth === 2);
---

<div class="reading">
  <div class="reading-grid">
    {
      toc.length >= 2 && (
        <nav class="toc" aria-labelledby="toc-title">
          <p class="toc-title" id="toc-title">
            On this page
          </p>
          <ol>
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <div class="prose">
      <slot />
    </div>
  </div>
  <Gallery />
</div>

<style>
  .reading {
    --measure: 65ch;
    --side-w: 260px;
    --side-gap: 56px;
    container: reading / inline-size;
  }
  .reading-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .prose {
    max-width: var(--measure);
    font-size: 16px;
  }
  .prose > :global(:first-child) {
    margin-top: 0;
  }
  .toc {
    margin-bottom: 40px;
    padding: 14px 0;
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line);
    font-family: var(--font-display);
  }
  .toc-title {
    margin: 0 0 10px;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--mute);
  }
  .toc ol {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: toc;
  }
  .toc li {
    counter-increment: toc;
  }
  .toc a {
    display: inline-flex;
    gap: 10px;
    align-items: baseline;
    min-height: 32px;
    padding: 4px 0;
    font-size: 14px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--mute);
  }
  .toc a::before {
    content: counter(toc, decimal-leading-zero);
    font-size: 11px;
    color: var(--cable);
  }
  .toc a:hover {
    color: var(--ink);
  }

  /* Medium: reading column plus an empty side column the notes float into. */
  @container reading (min-width: 900px) {
    .reading-grid {
      grid-template-columns: minmax(0, var(--measure)) minmax(var(--side-w), 1fr);
      column-gap: var(--side-gap);
    }
    .toc,
    .prose {
      grid-column: 1;
    }
    .prose :global(.sidenote) {
      float: right;
      clear: right;
      width: var(--side-w);
      margin: 0.35em calc(-1 * (var(--side-w) + var(--side-gap))) 1.2em 0;
    }
    .prose :global(.wide) {
      clear: right;
      margin-right: calc(-1 * (var(--side-w) + var(--side-gap)));
    }
  }

  /* Wide: a sticky contents rail on the left. */
  @container reading (min-width: 1180px) {
    .reading-grid {
      grid-template-columns: 180px minmax(0, var(--measure)) minmax(var(--side-w), 1fr);
    }
    .toc,
    .prose {
      grid-column: auto;
    }
    .toc {
      position: sticky;
      top: 32px;
      align-self: start;
      margin: 0;
    }
    .toc ol {
      flex-direction: column;
    }
  }
</style>
