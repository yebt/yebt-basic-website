---
/** Previous / next entry links at the foot of an entry page. */
interface Item {
  href: string;
  title: string;
}

interface Props {
  prev?: Item;
  next?: Item;
  /** Words for each direction, e.g. "Previous project" / "Next project". */
  prevLabel: string;
  nextLabel: string;
}

const { prev, next, prevLabel, nextLabel } = Astro.props;
---

<nav class="pager" aria-label="More entries">
  {
    prev ? (
      <a class="cell prev" href={prev.href} rel="prev">
        <span class="dir">
          <svg width="16" height="10" viewBox="0 0 16 10" aria-hidden="true">
            <path d="M16 5H2M6 1L2 5l4 4" fill="none" stroke="currentColor" />
          </svg>
          {prevLabel}
        </span>
        <span class="name">{prev.title}</span>
      </a>
    ) : (
      <span class="cell empty" />
    )
  }
  {
    next ? (
      <a class="cell next" href={next.href} rel="next">
        <span class="dir">
          {nextLabel}
          <svg width="16" height="10" viewBox="0 0 16 10" aria-hidden="true">
            <path d="M0 5h14M10 1l4 4-4 4" fill="none" stroke="currentColor" />
          </svg>
        </span>
        <span class="name">{next.title}</span>
      </a>
    ) : (
      <span class="cell empty" />
    )
  }
</nav>

<style>
  .pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
  }
  .cell {
    display: grid;
    gap: 10px;
    align-content: start;
    min-height: 112px;
    padding: 22px 24px;
    text-decoration: none;
  }
  .cell + .cell {
    border-left: 1px solid var(--line);
  }
  .next {
    text-align: right;
    justify-items: end;
  }
  .dir {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--mute);
  }
  .name {
    font-family: var(--font-display);
    font-size: clamp(18px, 2vw, 24px);
    line-height: 1.2;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  a.cell:hover {
    background: var(--slab);
  }
  a.cell:hover .dir {
    color: var(--ink);
  }
  @media (max-width: 640px) {
    .pager {
      grid-template-columns: 1fr;
    }
    .cell + .cell {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .empty {
      display: none;
    }
    .next {
      text-align: left;
      justify-items: start;
    }
  }
</style>
